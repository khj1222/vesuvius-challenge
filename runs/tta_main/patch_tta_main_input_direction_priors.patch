 .../inference/displacement_helpers.py         |   6 +
 .../inference/displacement_tta.py             |  36 ++++-
 .../test_displacement_tta_input_vectors.py    | 148 ++++++++++++++++++
 3 files changed, 188 insertions(+), 2 deletions(-)
 create mode 100644 vesuvius/tests/neural_tracing/test_displacement_tta_input_vectors.py

diff --git a/vesuvius/src/vesuvius/neural_tracing/inference/displacement_helpers.py b/vesuvius/src/vesuvius/neural_tracing/inference/displacement_helpers.py
index 580a120c2..6b6a23c4b 100644
--- a/vesuvius/src/vesuvius/neural_tracing/inference/displacement_helpers.py
+++ b/vesuvius/src/vesuvius/neural_tracing/inference/displacement_helpers.py
@@ -121,6 +121,12 @@ def predict_displacement(args, model_state, model_inputs, use_tta=None, profiler
             outlier_drop_min_keep=getattr(args, "tta_outlier_drop_min_keep", 4),
             tta_batch_size=getattr(args, "tta_batch_size", 2),
             profiler=profiler,
+            input_vector_channel_starts=(
+                (2, 5)
+                if model_state.get("model_config", {}).get("use_triplet_direction_priors", False)
+                and int(model_inputs.shape[1]) == 8
+                else ()
